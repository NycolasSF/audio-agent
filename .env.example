# Modelo Whisper padrão ao iniciar (tiny | base | small | medium | large)
# Pode ser alterado na interface sem reiniciar o servidor
WHISPER_MODEL=base

# ── Diarização — microsserviço 3D-Speaker no WSL2 ───────────────────────────
# O pipeline ModelScope segfauta no Python do Windows, então a diarização
# roda no WSL2 (Linux + GPU) num microsserviço FastAPI separado.
# O app sobe e derruba o microsserviço automaticamente (DIARIZER_AUTOSTART).
DIARIZER_URL=http://127.0.0.1:9020
# Timeout das chamadas /diarize em segundos (default = 30 min p/ áudios longos)
DIARIZER_TIMEOUT=1800

# Autostart do microsserviço quando o app sobe — desligue se quiser subir
# manualmente com: wsl -d Ubuntu -u root -- /mnt/f/.../wsl-diarizer/start.sh
DIARIZER_AUTOSTART=true
DIARIZER_WSL_DISTRO=Ubuntu
DIARIZER_WSL_USER=root
DIARIZER_START_SCRIPT=/mnt/f/claude-projetos/audio-agent/wsl-diarizer/start.sh
# Tempo limite (segundos) que o app espera o /health do microsserviço no boot
DIARIZER_STARTUP_TIMEOUT=30

# ── Worker pool ──────────────────────────────────────────────────────────────
# Limite de utilização da GPU em %. O worker dorme entre segmentos quando
# ultrapassado, mantendo sempre os % restantes livres para outras aplicações.
GPU_UTIL_LIMIT=70

# Limite de utilização da CPU em %. Mesma lógica do GPU_UTIL_LIMIT, aplicada
# aos workers CPU. Mantém o computador respondendo enquanto roda lote grande.
CPU_UTIL_LIMIT=50

# Workers extras usando apenas CPU (processam em paralelo com o worker GPU).
# Útil para transcrever múltiplos arquivos ao mesmo tempo. Com CPU_UTIL_LIMIT
# ativo, é seguro subir (ex.: 2-4) sem travar a máquina.
CPU_WORKERS=1

# Segundos de ociosidade do pool antes de descarregar Whisper + diarizador
# da VRAM. 0 = nunca descarrega (modelos sempre quentes — comportamento legado).
# 60 = libera VRAM após 1 min sem job; próxima transcrição paga ~2-5s de recarga.
MODEL_IDLE_TIMEOUT_SECONDS=60
