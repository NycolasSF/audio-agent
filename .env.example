# Modelo Whisper padrão ao iniciar (tiny | base | small | medium | large)
# Pode ser alterado na interface sem reiniciar o servidor
WHISPER_MODEL=base

# Token HuggingFace para pyannote/speaker-diarization-3.1 (diarização opt-in)
# Aceite os termos em https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=hf_...
